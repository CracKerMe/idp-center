# APP_URL: 应用的访问地址，用于 OAuth 回调、邮件链接等
APP_URL="http://localhost:5986"

JWT_SECRET="super-secret-jwt-key-change-in-prod"

# Encryption key for encrypting secrets at rest (TOTP secrets, client secrets, etc.)
# Must be 32+ characters. Falls back to JWT_SECRET if unset, but this is NOT recommended.
# ENCRYPTION_KEY="your-32-char-encryption-key-here"

# NODE_ENV controls schema push behavior: in production drizzle-kit push is skipped
# and migrations must be applied via `pnpm db:migrate` before the server starts.
NODE_ENV="development"

# Server port
PORT=5986

# First-run seed for the demo `default-client` OAuth client (server/database.ts). Comma-
# separated redirect_uri whitelist — /authorize requires an exact match against this list.
# Add every business app's callback URL you'll be testing against; after first run, manage
# this per-client via the admin UI/API (/api/admin/clients) instead of editing env vars.
# DEFAULT_CLIENT_REDIRECT_URIS="http://localhost:5986/callback,http://localhost:3000/callback"
# DEFAULT_CLIENT_POST_LOGOUT_REDIRECT_URIS="http://localhost:5986/,http://localhost:3000/"
# DEFAULT_CLIENT_FRONTCHANNEL_LOGOUT_URI="http://localhost:3000/logout-frontchannel"

# Token lifetime override (used by jsonwebtoken signing)
# JWT_EXPIRES_IN="15m"

# GitHub OAuth App credentials.
# Create an OAuth App at: GitHub → Settings → Developer settings → OAuth Apps
# Set the Authorization callback URL to: http://localhost:5986/api/auth/github/callback
GITHUB_CLIENT_ID="YOUR_GITHUB_CLIENT_ID"
GITHUB_CLIENT_SECRET="YOUR_GITHUB_CLIENT_SECRET"

# Optional: defaults to http://localhost:5986/api/auth/github/callback
# Change this to your production domain when deploying.
# GITHUB_CALLBACK_URL="https://yourdomain.com/api/auth/github/callback"

# SMTP configuration for sending emails (e.g., password resets).
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="your-smtp-username"
SMTP_PASS="your-smtp-password"
SMTP_FROM="your-smtp-from"

# PostgreSQL connection (DATABASE_URL takes priority over individual fields)
# DATABASE_URL="postgresql://postgres:password@localhost:5432/idp_center"
PG_HOST="localhost"
PG_PORT=5432
PG_USER="postgres"
PG_PASSWORD=""
PG_DATABASE="idp_center"
# Connection pool tuning (phase 4.1) — defaults are conservative for a single instance.
# PG_POOL_MAX=10
# PG_IDLE_TIMEOUT_SEC=30
# PG_CONNECT_TIMEOUT_SEC=10

# Phase 3.1: risk engine (adaptive auth). Start with 'shadow' for ~2 weeks before 'enforce'.
# off | shadow | enforce
RISK_ENGINE_MODE="off"

# Enforce client grant_types in the /token endpoint.
# 'warn' logs violations but allows them (transition mode); 'enforce' rejects.
# OAUTH_ENFORCE_GRANT_TYPES="warn"

# Optional local MaxMind GeoLite2-City.mmdb path — unset disables geo-based risk signals.
# GEOIP_DB_PATH="./data/GeoLite2-City.mmdb"

# Phase 3.3: LLM-assisted admin tooling (audit summaries, policy drafts, compliance checks).
# Unset disables every /api/admin/ai/* endpoint (501).
# ANTHROPIC_API_KEY=""

# Phase 4.2: shared cache/rate-limit/leader-election backend. Unset falls back to an
# in-process implementation — fine for a single instance, NOT safe across replicas.
# REDIS_URL="redis://localhost:6379"

# Bearer token required to scrape /metrics (Prometheus endpoint). Unset = no auth.
# METRICS_TOKEN="your-metrics-bearer-token"

# SMS provider for MFA (sms service). Supported: console | aliyun | tencent
# SMS_PROVIDER="console"
# Aliyun SMS
# ALIYUN_SMS_ACCESS_KEY_ID=""
# ALIYUN_SMS_ACCESS_KEY_SECRET=""
# ALIYUN_SMS_SIGN_NAME=""
# ALIYUN_SMS_TEMPLATE_CODE=""
# Tencent SMS
# TENCENT_SMS_SECRET_ID=""
# TENCENT_SMS_SECRET_KEY=""
# TENCENT_SMS_SIGN_NAME=""
# TENCENT_SMS_TEMPLATE_ID=""
# TENCENT_SMS_SDK_APP_ID=""

# Application version (exposed in /metrics, not functionally used)
# APP_VERSION="1.0.0"
