# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

JWT_SECRET="super-secret-jwt-key-change-in-prod"
JWT_REFRESH_SECRET="super-secret-refresh-key-change-in-prod"

# GitHub OAuth App credentials.
# Create an OAuth App at: GitHub → Settings → Developer settings → OAuth Apps
# Set the Authorization callback URL to: http://localhost:5986/api/auth/github/callback
GITHUB_CLIENT_ID="YOUR_GITHUB_CLIENT_ID"
GITHUB_CLIENT_SECRET="YOUR_GITHUB_CLIENT_SECRET"

# Optional: defaults to http://localhost:5986/api/auth/github/callback
# Change this to your production domain when deploying.
# GITHUB_CALLBACK_URL="https://yourdomain.com/api/auth/github/callback"

# SMTP configuration for sending emails (e.g., password resets).
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="your-smtp-username"
SMTP_PASS="your-smtp-password"
SMTP_FROM="your-smtp-from"

# PostgreSQL connection (DATABASE_URL takes priority over individual fields)
# DATABASE_URL="postgresql://postgres:password@localhost:5432/idp_center"
PG_HOST="localhost"
PG_PORT=5432
PG_USER="postgres"
PG_PASSWORD=""
PG_DATABASE="idp_center"
