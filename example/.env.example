# IDP Center 主应用地址（vite.config.ts 的代理目标也指向这里）
VITE_IDP_CENTER_URL=http://localhost:5986

# OAuth2/OIDC 演示用的客户端。default-client 的 secret 由主应用首次启动时随机生成并打印在
# 控制台（不再是固定的 secret123），从主应用启动日志里复制过来。
# 只有 OAuth2/OIDC 授权码演示（Home 页 "Start Authorization" / SSO 登录）需要它；
# 直接用户名密码登录（Login 页表单）不需要配置这个文件也能跑。
VITE_CLIENT_ID=default-client
VITE_CLIENT_SECRET=

# 必须和主应用 clients 表里 default-client 的 redirect_uris 一致
VITE_REDIRECT_URI=http://localhost:3000/callback
